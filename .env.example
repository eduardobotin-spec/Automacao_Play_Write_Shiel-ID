# Cópia para .env (não commitar .env com senha real)
# Teto de linhas por SELECT na automação (1..20; nunca acima de 20 no código)
# DB_SAFE_SELECT_MAX=20

# --- Produção (só no .env local; nunca commitar host/senha reais) ---
# Marque o host que deve ser tratado como produção (mesmo valor que DB_HOST ao apontar para prod).
# DB_PRODUCTION_HOST=
# Vários hosts: DB_PRODUCTION_HOSTS=host1,host2
# Só depois de autorização explícita E de ter executado o mesmo fluxo em staging:
# DB_PRODUCTION_EXECUTION_ALLOWED=yes
# DB_PRODUCTION_AFTER_STAGING=yes
# Leitura: serviços consultar* chamam assertProductionReadConnectionAllowed.
# Escrita (limpar/configurar/update preços): bloqueada para host de produção (assertProductionWriteBlocked).

# Coluna JSON em logs_general (padrão `data`). Para inventário antigo por logs_general:
# LOGS_GENERAL_JSON_COLUMN=data
# LOGS_GENERAL_FILTER_COLUMN=data

# Tabela hash_json (coluna JSON da hash — em PG use aspas no nome "json"):
# Host/porta/user/senha: padrão igual a DB_DOCUMENTS_*; só definir HASH_JSON_* se for diferente.
# HASH_JSON_DATABASE=   (padrão: DB_DOCUMENTS_NAME ou "database")
# HASH_JSON_TABLE=hash_json
# Se a tabela foi criada como identificador maiúsculo no PG, use nome com maiúsculas (ex.: HASH_JSON) — o código coloca aspas automaticamente.
# HASH_JSON_QUOTE_IDENTIFIERS=yes  (força aspas em schema/tabela/id)
# HASH_JSON_ID_COLUMN=id
# HASH_JSON_JSON_COLUMN=json

# Web — painel Shiel ID (staging)
DASHBOARD_URL=https://painel.shielid-staging.com/login?redirect=%2Fdashboard
DASHBOARD_LOGIN=
# Compatibilidade com chaves antigas (opcional):
DASHBOARD_USER=
DASHBOARD_PASSWORD=
