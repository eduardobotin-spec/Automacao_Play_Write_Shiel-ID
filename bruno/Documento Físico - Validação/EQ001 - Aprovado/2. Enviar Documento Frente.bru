meta {
  name: 2. Enviar Documento Frente
  type: http
  seq: 2
}

post {
  url: {{kyc_url}}/api/v1/kyc/{{tenant_id}}/{{hash}}/process-document
  body: multipartForm
}

headers {
  tenant-id: {{tenant_id}}
  x-api-key: {{api_key}}
}

body:multipart-form {
  document_side: front
  document_image: @file(_documento_fisico/EQ001_APROVADO/frente.jpeg)
}

script:pre-request {
  bru.setVar("hash", bru.getVar("eq001_hash"));
}

script:post-response {
  console.log("[EQ001] Documento frente enviado:", res.getStatus());
  if (res.getStatus() !== 200) {
    console.error("[EQ001] Erro frente:", JSON.stringify(res.getBody()));
  }
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
